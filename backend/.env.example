# Copia este archivo como ".env" y llena tus valores reales.
# El archivo .env NUNCA se sube a GitHub (ya está en el .gitignore).

# Puerto donde corre la API
PORT=3000

# Cadena de conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/blogsexpertos

# Secreto para firmar los tokens JWT (cámbienlo por un texto largo y difícil)
JWT_SECRET=cambia_este_secreto_por_uno_largo

# Cuánto dura un token antes de vencer (ej.: 1h, 1d, 7d)
JWT_EXPIRES_IN=1d
